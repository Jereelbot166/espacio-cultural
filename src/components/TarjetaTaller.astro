---
interface Props {
  nombre: string;
  descripcion: string;
  imagen: string;
}

const { nombre, descripcion, imagen } = Astro.props;
---
<article class="tarjeta">
  <img src={imagen} alt={nombre} class="tarjeta-img" />
  <div class="tarjeta-contenido">
    <h3>{nombre}</h3>
    <p>{descripcion}</p>
  </div>
</article>

<style>
  .tarjeta {
    background-color: var(--card-bg);
    border-radius: 8px;
    overflow: hidden;
    box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
    display: flex;
    flex-direction: column;
  }
  .tarjeta-img {
    width: 100%;
    height: 180px;
    object-fit: cover;
  }
  .tarjeta-contenido {
    padding: 1rem;
    flex: 1;
  }
  .tarjeta-contenido h3 {
    color: var(--primary-color);
    margin-bottom: 0.5rem;
  }
</style>